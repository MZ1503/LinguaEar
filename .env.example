EXPO_PUBLIC_GROQ_API_KEY=
EXPO_PUBLIC_GROQ_MODEL=openai/gpt-oss-20b
EXPO_PUBLIC_USE_RN_FETCH=1
# Auth API. On a physical phone use your computer LAN IP, e.g. http://192.168.1.20:8765
EXPO_PUBLIC_API_URL=http://localhost:8765

# Vision-capable Groq model for the camera translator
EXPO_PUBLIC_GROQ_VISION_MODEL=qwen/qwen3.8-27b
