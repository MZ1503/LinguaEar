# Backend API address.
# - A deployed backend (https://...) is used everywhere: in development and in builds.
# - While developing against the backend on your own computer, leave this as http://localhost:8765. The app
#   then finds your computer's address from Metro by itself, so it keeps working when your Wi-Fi changes.
# The AI key (Groq) lives only in the backend's environment as GROQ_API_KEY, never in the app.
EXPO_PUBLIC_API_URL=http://localhost:8765
