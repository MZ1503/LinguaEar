{
  "expo": {
    "name": "LinguaEar",
    "slug": "LinguaEar",
    "version": "3.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "linguaear",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050510",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "versionCode": 6,
      "package": "com.linguaear.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ear-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ear-logo.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#0b0f19",
          "dark": {
            "backgroundColor": "#0b0f19"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "350e8d56-46a6-4999-b8bf-7a3fe957e649"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/350e8d56-46a6-4999-b8bf-7a3fe957e649"
    }
  }
}